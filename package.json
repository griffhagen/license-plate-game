{
  "name": "license-plate-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --host",
    "dev:server": "NODE_ENV=development node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "icons:sync": "cp -f icons/*.png icons/favicon.ico public/icons/",
    "plates": "node scripts/download-plates.mjs",
    "bonus-plates": "node scripts/download-bonus-plates.mjs",
    "bonus-plates:svgs": "node scripts/generate-bonus-plate-svgs.mjs",
    "census:facts": "node scripts/fetch-census-statefacts.mjs",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  },
  "overrides": {
    "ws": "^8.21.1",
    "body-parser": "^1.20.6"
  }
}
